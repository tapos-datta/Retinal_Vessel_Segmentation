# ---------------------------------------------------------------- datasets
# Images, labels and FOV masks are never committed; only metadata and splits are.
data/*
!data/pool/
data/pool/*
!data/pool/metadata.csv
!data/pool/MANIFEST.sha256
!data/external_FIVES/
data/external_FIVES/*
!data/external_FIVES/metadata.csv
!data/external_FIVES/MANIFEST.sha256

# ---------------------------------------------------------------- model weights and scratch runs
runs/**/*.pt
runs_smoke/
runs_check/

# ---------------------------------------------------------------- cached intermediates
# Probability maps and prediction caches; regenerated by the scripts that need them.
results_smoke/
results/fov_edge/probs/
results/prediction_figure/cache/
*.npy

# Historical intermediate figure galleries (kept local; final figures remain tracked)
figures/enhancement_run1/
figures/enhancement_run2/
figures/v2_check/
figures/s1_hybrid_HRF/

# ---------------------------------------------------------------- environments, logs, caches
.venv/
.venv-mac/
env/
__pycache__/
*.py[cod]
*.egg-info/
logs/

# ---------------------------------------------------------------- release staging
dist/

# ---------------------------------------------------------------- editors and OS
.DS_Store
.idea/
.vscode/
*.tmp
*.swp

# ---------------------------------------------------------------- internal working files (kept local)
# Running state, decision log and manuscript drafts. The published documentation
# in docs/ is generated from these; the sources themselves are not public.
REPORT.md
REPORT_stage6b_update.md
PROTOCOL.md
WRITING_PLAN.md
# the LaTeX project at the repository root; the leading slash keeps figures/report/
/report/

# LaTeX build artefacts, in case the report folder is ever un-ignored
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.toc
*.synctex.gz
