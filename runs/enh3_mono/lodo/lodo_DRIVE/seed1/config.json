{
  "data": {
    "pool": "data/pool",
    "patch_size": 384,
    "preprocess": "rgb",
    "scale_norm": false,
    "mask_fov": true,
    "target_fov": 960,
    "full_image_prob": 0.0,
    "balance_datasets": true
  },
  "augment": {
    "photometric": "basic",
    "rotate_deg": 20,
    "scale_range": [
      0.8,
      1.25
    ]
  },
  "model": {
    "enhancement": "v3",
    "imagenet_norm": false,
    "output": "fused",
    "enh3": {
      "sigmas": [
        16.0,
        48.0,
        128.0
      ],
      "noise_floor": 0.05,
      "weber_gain": 4.0,
      "outlier_cap": 0.35,
      "res_channels": 24,
      "residual": true,
      "fusion": "mono",
      "raw_gate_init": 0.25
    }
  },
  "loss": {
    "w_bce": 0.5,
    "w_tversky": 0.5,
    "tversky_alpha": 0.3,
    "tversky_beta": 0.7,
    "fov_only": true
  },
  "train": {
    "device": "auto",
    "batch_size": 8,
    "iterations": 12000,
    "lr": 0.0003,
    "weight_decay": 1e-05,
    "warmup": 500,
    "val_every": 1000,
    "patience": 6,
    "workers": 4,
    "gpu_memory_fraction": 0.4,
    "log_every": 100
  },
  "inference": {
    "overlap": 96,
    "batch": 8,
    "threshold": 0.5,
    "tta_test": true
  },
  "_note": "EnhancementV3 monochrome ablation ('mono'): same outlier-clipped Weber normalization + dilated residual CNN at native resolution, triplicated [enh, enh, enh] without Red/raw fusion."
}